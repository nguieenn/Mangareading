{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=MangaReaderDB;User Id=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;MultipleActiveResultSets=true;TrustServerCertificate=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "System": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "None",
      "System.Data.SqlClient": "Warning",
      "Microsoft.Data": "Warning"
    },
    "File": {
      "Enabled": true
    }
  },
  "AWS.Logging": {
    "Region": "us-east-1",
    "LogGroup": "MangaReading.Logs",
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "None",
      "System.Data.SqlClient": "Warning",
      "Microsoft.Data": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      },
      "Https": {
        "Url": "https://0.0.0.0:5001",
        "Certificate": {
          "Development": {
            "Path": "cert-aspnetcore.pfx",
            "Password": "YOUR_DEVELOPMENT_CERTIFICATE_PASSWORD"
          }
        }
      }
    }
  },
  "AllowedHosts": "*",
  "ExternalServices": {
    "Imgur": {
      "ClientId": "YOUR_IMGUR_CLIENT_ID",
      "ClientSecret": "YOUR_IMGUR_CLIENT_SECRET",
      "RefreshToken": "YOUR_IMGUR_REFRESH_TOKEN"
    }
  }
}
